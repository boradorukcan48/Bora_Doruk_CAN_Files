        <a href="#" class="nav-item" data-page="siparisler" onclick="showPage('siparisler', event)">🧾 Siparişler</a>
        <a href="#" class="nav-item" data-page="musteriler" onclick="showPage('musteriler', event)">👤 Müşteriler</a>
        <a href="#" class="nav-item" data-page="ayarlar" onclick="showPage('ayarlar', event)">⚙️ Ayarlar</a>
