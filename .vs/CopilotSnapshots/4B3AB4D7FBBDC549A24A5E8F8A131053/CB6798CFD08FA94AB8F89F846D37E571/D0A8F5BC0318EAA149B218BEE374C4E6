                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>Mariye Ece</td>
                                <td>mariyeece@gmail.com</td>
                                <td>+90 386 234 56 78</td>
                                <td>3</td>
                                <td>19.05.2027</td>
                            </tr>
                            <tr>
                                <td>Bora Doruk Can</td>
                                <td>boradorukcan@gmail.com</td>
                                <td>+90 212 234 56 78</td>
