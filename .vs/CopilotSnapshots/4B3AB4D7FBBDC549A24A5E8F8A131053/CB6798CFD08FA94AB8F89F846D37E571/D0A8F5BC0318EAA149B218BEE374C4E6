                        <p>Yönetim paneline hoş geldiniz.</p>
                    </div>
                    <div class="card-icon">📊</div>
                </div>

                <div class="card success" onclick="showPage('urunler', event)" style="cursor: pointer;">
                    <div>
                        <h3>Ürünler</h3>
                        <p>Ürün kayıtlarını yönetin.</p>
                    </div>
                    <div class="card-icon">📦</div>
                </div>

                <div class="card warning" onclick="showPage('siparisler', event)" style="cursor: pointer;">
                    <div>
                        <h3>Siparişler</h3>
                        <p>Gönderim ve ödemeleri takip edin.</p>
                    </div>
                    <div class="card-icon">🧾</div>
                </div>

                <div class="card info" onclick="showPage('musteriler', event)" style="cursor: pointer;">
                    <div>
                        <h3>Müşteriler</h3>
                        <p>Kayıtlı kullanıcıları inceleyin.</p>
                    </div>
                    <div class="card-icon">👤</div>
                </div>

                <div class="card secondary" onclick="showPage('ayarlar', event)" style="cursor: pointer;">
                    <div>
                        <h3>Ayarlar</h3>
                        <p>Panel ayarlarını yönetin.</p>
                    </div>
                    <div class="card-icon">⚙️</div>
                </div>
            </div>
        </div>

        <!-- ÜRÜNLER PAGE -->
        <div id="urunler" class="page">
            <div class="topbar">
                <h1 class="topbar-title">Ürünler</h1>
                <div class="topbar-actions">
                    <span class="pill">Yönetici</span>
                </div>
            </div>

            <div class="content">
                <div class="card-header">
                    <h2>Ürün Listesi</h2>
                    <button class="btn-primary" onclick="openNewProductModal()">+ Yeni Ürün</button>
                </div>

                <div class="table-container">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Ürün Adı</th>
                                <th>Kategori</th>
                                <th>Fiyat</th>
                                <th>Stok</th>
                                <th>İşlemler</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>Elbise</td>
                                <td>Moda</td>
                                <td>₺1,499.99</td>
                                <td>11</td>
                                <td>
                                    <button class="btn-small" onclick="openEditModal(0, 'Elbise', 'Moda', '1499.99', '11')">Düzenle</button>
                                    <button class="btn-small danger" onclick="deleteProduct(0)">Sil</button>
                                </td>
                            </tr>
                            <tr>
                                <td>Mouse</td>
                                <td>Elektronik</td>
                                <td>₺2,199.99</td>
                                <td>9</td>
                                <td>
                                    <button class="btn-small" onclick="openEditModal(1, 'Mouse', 'Elektronik', '2199.99', '9')">Düzenle</button>
                                    <button class="btn-small danger" onclick="deleteProduct(1)">Sil</button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- SİPARİŞLER PAGE -->
        <div id="siparisler" class="page">
            <div class="topbar">
                <h1 class="topbar-title">Siparişler</h1>
