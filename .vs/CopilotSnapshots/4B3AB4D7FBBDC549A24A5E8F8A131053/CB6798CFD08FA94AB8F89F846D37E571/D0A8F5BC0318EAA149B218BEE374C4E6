                    <span class="pill">Yönetici</span>
                </div>
            </div>

            <div class="content">
                <div class="card-header">
                    <h2>Sipariş Listesi</h2>
                </div>

                <div class="table-container">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Sipariş No</th>
                                <th>Müşteri</th>
                                <th>Tutar</th>
                                <th>Durum</th>
                                <th>Tarih</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>#OWO67890</td>
                                <td>Mariye Ece</td>
                                <td>₺1,499.99</td>
                                <td><span class="badge warning">Kargoda</span></td>
                                <td>31.08.2026</td>
                            </tr>
                            <tr>
                                <td>#UWU12345</td>
                                <td>Bora Doruk Can</td>
                                <td>₺2,199.99</td>
                                <td><span class="badge success">Tamamlandı</span></td>
